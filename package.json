{
	"name": "api--ts-template",
	"version": "1.0.0",
	"description": "TypeScript API template designed for single-tenant apps",
	"main": "index.js",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"worker": "dotenv -e .env -- ts-node-dev --transpile-only --exit-child --watch .env --require tsconfig-paths/register src/worker.ts",
		"start": "node dist/index.js",
		"dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only --exit-child --watch .env --require tsconfig-paths/register src/index.ts",
		"lint": "eslint \"{src,test}/**/*.ts\"",
		"lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
		"format": "prettier --write \"{src,test}/**/*.ts\"",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iamezga/api--ts-template.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/iamezga/api--ts-template/issues"
	},
	"homepage": "https://github.com/iamezga/api--ts-template#readme",
	"dependencies": {
		"@prisma/adapter-pg": "^7.2.0",
		"@prisma/client": "^7.2.0",
		"@sentry/node": "^10.8.0",
		"@sentry/profiling-node": "^10.8.0",
		"argon2": "^0.44.0",
		"bullmq": "^5.58.5",
		"convict": "^6.2.4",
		"cors": "^2.8.5",
		"dayjs": "^1.11.18",
		"express": "^5.1.0",
		"fastest-validator": "^1.19.1",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"mongodb": "^6.18.0",
		"ms": "^2.1.3",
		"nodemailer": "^6.9.14",
		"object-path": "^0.11.8",
		"pg": "^8.16.3",
		"pino": "^9.7.0",
		"rate-limiter-flexible": "^7.3.0",
		"redis": "^5.7.0",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^9.32.0",
		"@types/convict": "^6.1.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/helmet": "^4.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.0.3",
		"@types/nodemailer": "^6.4.12",
		"@types/object-path": "^0.11.4",
		"@types/pg": "^8.16.0",
		"@vitest/coverage-v8": "^4.1.6",
		"dotenv-cli": "^10.0.0",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"jiti": "^2.5.1",
		"pino-pretty": "^13.1.1",
		"prisma": "^7.2.0",
		"rimraf": "^6.0.1",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.38.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.6"
	}
}
