APP_NAME=my-app-name
NODE_ENV=development
PORT=5000
EXPRESS_REQUEST_BODY_SIZE=50mb
EXPRESS_CORS_ORIGIN=*
FRONT_URL=https://example.com

#| SENTRY
SENTRY_DSN="DSN"
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

#| PROVIDERS
DATABASE_PROVIDERS=mongo,postgres,redis
AUDIT_PROVIDER=mongo

#| MONGO
MONGO_URL=
MONGO_DB_NAME=

#| POSTGRES
POSTGRES_URL=

#| REDIS
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

#| JWT
JWT_SECRET=my_super_secret
JWT_MAX_AGE=86400s # 1 day
JWT_EXPIRES_IN="1 day"
JWT_PASSWORD_RECOVER_EXPIRES_IN="1 hour"

#| EMAIL SERVICE PROVIDER
#| Options: 'log' (development, logs to console) or 'nodemailer' (production, SMTP)
EMAIL_PROVIDER=log
SUPPORT_EMAIL=support@example.com

#| NODEMAILER SMTP CONFIGURATION (only needed if EMAIL_PROVIDER=nodemailer)
#| For Gmail: use smtp.gmail.com, port 587, secure=false, and an app-specific password
#| For other providers: check their SMTP documentation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

#| TEST EMAIL (only for integration tests)
TEST_EMAIL=your-test-email@example.com