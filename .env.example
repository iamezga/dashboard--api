APP_NAME=my-app-name
NODE_ENV=development
PORT=5000
EXPRESS_REQUEST_BODY_SIZE=50mb
EXPRESS_CORS_ORIGIN=*

#| SENTRY
SENTRY_DSN="DSN"
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

#| MONGO
MONGO_URL=
MONGO_DB_NAME=

#| POSTGRES
POSTGRES_URL=

#| REDIS
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

#| JWT
JWT_SECRET=my_super_secret
JWT_MAX_AGE=86400s # 1 day
JWT_EXPIRES_IN="1 day"
JWT_PASSWORD_RECOVER_EXPIRES_IN="1 hour"