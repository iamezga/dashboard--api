{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "lib": ["ESNext"],
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "removeComments": false,
        "importHelpers": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals"],
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "Node",
        "inlineSources": true,
        "sourceRoot": "/",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "coverage"]
}